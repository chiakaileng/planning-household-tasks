// SQLite is enough for one household. DATABASE_URL lives in .env.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id         String   @id @default(cuid())
  title      String
  sourceType String
  sourceUrl  String?
  sourceText String?
  servings      Int?
  calories      Int?
  protein       Float?
  fat           Float?
  carbohydrates Float?
  fibre         Float?
  notes         String?
  emojis     String   @default("[]")
  createdAt  DateTime @default(now())
  ingredients Ingredient[]
  steps       Step[]
  tags        RecipeTag[]
  mealDishes  MealDish[]
}

model Ingredient {
  id           String  @id @default(cuid())
  recipeId     String
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name         String
  quantity     String?
  unit         String?
  note         String?
  parseFlagged Boolean @default(false)
  sortOrder    Int
}

model Step {
  id          String @id @default(cuid())
  recipeId    String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  instruction String
  sortOrder   Int
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

// One household, no accounts — just people later meals can pick as eaters or cooks.
model Member {
  id              String   @id @default(cuid())
  name            String
  lifeStage       String
  avatarMode      String
  avatarPresetKey String?
  createdAt       DateTime @default(now())
  cookedDishes    MealDish[]
  eatenDishes     MealDishEater[]
}

// One meal (breakfast, lunch, dinner, or an extra) on one calendar day.
model Meal {
  id        String     @id @default(cuid())
  date      String
  slotKey   String
  name      String
  sortOrder Int
  isExtra   Boolean    @default(false)
  dishes    MealDish[]
  leftoverOf MealDish[] @relation("LeftoverSource")

  @@unique([date, slotKey])
}

// Extra meals for a week, optionally repeating on later weeks (slot only, not dishes).
model ExtraMealTemplate {
  id                 String   @id @default(cuid())
  name               String
  insertAfterSlotKey String
  appliesFromWeek    String
  recurs             Boolean
  createdAt          DateTime @default(now())
}

model MealDish {
  id               String          @id @default(cuid())
  mealId           String
  meal             Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  contentType      String
  recipeId         String?
  recipe           Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  sourceMealId     String?
  sourceMeal       Meal?           @relation("LeftoverSource", fields: [sourceMealId], references: [id], onDelete: SetNull)
  sourceDishId     String?
  leftoverText     String?
  freeformText     String?
  titleSnapshot    String
  cookMemberId     String?
  cook             Member?         @relation(fields: [cookMemberId], references: [id], onDelete: SetNull)
  cookNameSnapshot String
  sortOrder        Int
  eaters           MealDishEater[]
}

model MealDishEater {
  id           String   @id @default(cuid())
  dishId       String
  dish         MealDish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  nameSnapshot String
}

// One row per Gemini call so you can see this-call and lifetime estimated spend.
model LlmUsageEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  model         String
  purpose       String
  inputTokens   Int
  outputTokens  Int
  estimatedUsd  Float
}
