# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=

# Gemini generateContent host and model — change these without touching code.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.5-flash

# Paid-tier list prices used only to estimate spend. Free-tier keys may actually cost $0.
# Update if you change model: https://ai.google.dev/gemini-api/docs/pricing
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50

PAGE_FETCH_TIMEOUT_MS=10000
PAGE_FETCH_USER_AGENT=HouseholdMealPlanner/0.1 (recipe-import)

# Local: file:./dev.db   Railway smoke test: file:/tmp/household.db
DATABASE_URL=file:./dev.db

# Week board: whose “today,” which weekday starts the grid, leftover lookback.
WEEK_TIMEZONE=Asia/Singapore
WEEK_STARTS_ON=1
LEFTOVER_LOOKBACK_DAYS=7

# Telegram announce (optional). One chat — group or private. Never commit real tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DATE_LOCALE=en-SG
TELEGRAM_WEEKLY_WEEKDAY=0
TELEGRAM_WEEKLY_HOUR=19
TELEGRAM_NIGHT_BEFORE_HOUR=20
TELEGRAM_SEND_TIMEOUT_MS=10000
TELEGRAM_SCHEDULER_INTERVAL_MS=30000
TELEGRAM_POLL_TIMEOUT_SEC=25
TELEGRAM_POLL_IDLE_MS=250
TELEGRAM_PICKER_PAGE_SIZE=6
TELEGRAM_MAX_MESSAGE_CHARS=4096
TELEGRAM_INTERVIEW_LABEL_CHARS=48
