# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=

# Gemini generateContent host and model — change these without touching code.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.5-flash

# Paid-tier list prices used only to estimate spend. Free-tier keys may actually cost $0.
# Update if you change model: https://ai.google.dev/gemini-api/docs/pricing
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50

PAGE_FETCH_TIMEOUT_MS=10000
PAGE_FETCH_USER_AGENT=HouseholdMealPlanner/0.1 (recipe-import)

DATABASE_URL=file:./dev.db
